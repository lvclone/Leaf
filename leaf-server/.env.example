# Copy this file to .env, edit the values, then source it before starting Leaf.
LEAF_NAME=leaf

# Local MySQL container settings.
MYSQL_ROOT_PASSWORD=leaf-root-local-only
MYSQL_DATABASE=leaf
MYSQL_USER=leaf
MYSQL_PASSWORD=leaf-local-only
MYSQL_PORT=3306

# Segment mode uses the MySQL container configured above.
LEAF_SEGMENT_ENABLE=true
LEAF_SEGMENT_ALLOC_STRATEGY_DAO_BEAN_NAME=
LEAF_SEGMENT_URL='jdbc:mysql://127.0.0.1:3306/leaf?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai'
LEAF_SEGMENT_USERNAME=leaf
LEAF_SEGMENT_PASSWORD=leaf-local-only

# Snowflake mode requires a reachable ZooKeeper ensemble.
LEAF_SNOWFLAKE_ENABLE=false
LEAF_SNOWFLAKE_ADDRESS=127.0.0.1:2181
LEAF_SNOWFLAKE_PORT=8080

# HTTP port used by Spring Boot.
SERVER_PORT=8080
